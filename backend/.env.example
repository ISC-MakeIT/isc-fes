DATABASE_URL=postgres://isc-fes:devpassword@localhost:5432/isc-fes?sslmode=disable

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

SESSION_COOKIE_SECURE=
SESSION_COOKIE_DOMAIN=

FRONTEND_URL=http://localhost:3000
# 複数指定する場合はカンマ区切り
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8082

AWS_REGION=ap-northeast-1

# 本番では EC2 の IAM を使うので、いらない
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

S3_BUCKET=isc-fes-local
S3_ENDPOINT=http://localhost:4566
S3_USE_PATH_STYLE=true
# 未設定の場合はS3のPresigned URLを生成する
STORE_IMAGE_BASE_URL=
