NEXT_PUBLIC_API_BASE_URL=

# Sentry の frontend プロジェクトで発行した DSN
NEXT_PUBLIC_SENTRY_DSN=
# ローカルと Vercel Preview は dev、Vercel Production は prod
# Vercel では NEXT_PUBLIC_VERCEL_ENV をシステム環境変数として自動提供

# GA4 Web データストリームの測定 ID。Vercel Production に設定する
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# ローカルから DebugView に送る場合のみ true（通常は未設定）
# NEXT_PUBLIC_GA_DEBUG_SEND=true
