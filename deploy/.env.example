POSTGRES_USER=isc-fes
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=isc-fes
# POSTGRES_PASSWORDにURL予約文字を含める場合はpercent-encodeする。
DATABASE_URL=postgres://isc-fes:<percent-encoded-password>@db:5432/isc-fes?sslmode=disable

GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URL=<backend-url>/auth/google/callback
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=fes.iwasaki.ac.jp
FRONTEND_URL=<frontend-url>
# 複数指定する場合はカンマ区切り
CORS_ALLOWED_ORIGINS=<frontend-url>[,<additional-origin>...]

AWS_REGION=ap-northeast-1
S3_BUCKET=<s3-bucket-name>
# DNS設定前はTerraform outputのCloudFront標準ドメインを指定する。
STORE_IMAGE_BASE_URL=https://<cloudfront-domain-name>
