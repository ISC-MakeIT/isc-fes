# ECRへpush済みの、Commit SHAを含む不変Tagを指定する。
BACKEND_IMAGE=970835573274.dkr.ecr.ap-northeast-1.amazonaws.com/isc-fes/backend:sha-<git-commit-sha>

POSTGRES_USER=isc-fes
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=isc-fes
# POSTGRES_PASSWORDにURL予約文字を含める場合はpercent-encodeする。
DATABASE_URL=postgres://isc-fes:<percent-encoded-password>@db:5432/isc-fes?sslmode=disable

GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URL=https://api.fes.iwasaki.ac.jp/auth/google/callback
SESSION_COOKIE_SECURE=true
FRONTEND_URL=https://fes.iwasaki.ac.jp

AWS_REGION=ap-northeast-1
S3_BUCKET=isc-fes-images-970835573274
